{
  "app-id": "io.github.obaidr1.obiview",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "bildblick",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "pybind11",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --find-links=file://${PWD} --prefix=${FLATPAK_DEST} --no-build-isolation pybind11"
      ],
      "cleanup": ["*"],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/b3/06/c3a23c9a0263b136c519f033a58d4641e73065fefc7754e9667ec206d992/pybind11-3.0.4-py3-none-any.whl",
          "sha256": "961720ee652da51d531b7b2451a6bd2bc042b0106e6d9baa48ecb7d58034ce63"
        }
      ]
    },
    {
      "name": "pillow",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --find-links=file://${PWD} --prefix=${FLATPAK_DEST} --no-build-isolation Pillow"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/8c/21/c2bcdd5906101a30244eaffc1b6e6ce71a31bd0742a01eb89e660ebfac2d/pillow-12.2.0.tar.gz",
          "sha256": "a830b1a40919539d07806aa58e1b114df53ddd43213d9c8b75847eee6c0182b5"
        }
      ]
    },
    {
      "name": "bildblick",
      "buildsystem": "simple",
      "build-commands": [
        "install -d ${FLATPAK_DEST}/share/bildblick",
        "install -m 644 *.py ${FLATPAK_DEST}/share/bildblick/",
        "install -Dm 644 design-system/tokens.json ${FLATPAK_DEST}/share/bildblick/design-system/tokens.json",
        "install -Dm 755 packaging/flatpak/bildblick-launcher ${FLATPAK_DEST}/bin/bildblick",
        "install -Dm 644 packaging/flatpak/io.github.obaidr1.obiview.desktop ${FLATPAK_DEST}/share/applications/io.github.obaidr1.obiview.desktop",
        "install -Dm 644 packaging/flatpak/io.github.obaidr1.obiview.metainfo.xml ${FLATPAK_DEST}/share/metainfo/io.github.obaidr1.obiview.metainfo.xml",
        "install -Dm 644 assets/local.bildblick.Viewer.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/io.github.obaidr1.obiview.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
