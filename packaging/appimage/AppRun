#!/bin/sh
set -eu

APPDIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export APPDIR
export PYTHONHOME="$APPDIR/usr"
export PYTHONPATH="$APPDIR/usr/lib/python3/dist-packages:$APPDIR/usr/lib/python3.12/site-packages:$APPDIR/usr/share/bildblick${PYTHONPATH:+:$PYTHONPATH}"
export GI_TYPELIB_PATH="$APPDIR/usr/lib/x86_64-linux-gnu/girepository-1.0"
export GTK_DATA_PREFIX="$APPDIR/usr"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GDK_PIXBUF_MODULE_FILE="$APPDIR/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders.cache"
export LD_LIBRARY_PATH="$APPDIR/usr/lib/x86_64-linux-gnu:$APPDIR/lib/x86_64-linux-gnu:$APPDIR/lib/x86_64:$APPDIR/usr/lib:$APPDIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec "$APPDIR/usr/bin/python3" "$APPDIR/usr/share/bildblick/bildblick.py" "$@"
